# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is git-ignored. NEVER commit a real API key.

# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by all agents
BOTTEGA_MODEL=claude-sonnet-5-5
# How hard the model thinks: low | medium | high | xhigh | max
BOTTEGA_EFFORT=medium
# Max output tokens per API call
BOTTEGA_MAX_TOKENS=32000
# Max API calls one agent may make for one task
BOTTEGA_MAX_TURNS=25
# Where generated projects are written
BOTTEGA_OUTPUT_DIR=output
# Company memory (an Obsidian vault shared by all projects)
BOTTEGA_MEMORY_DIR=memory
# Retry declined requests on a fallback model (server-side)
BOTTEGA_REFUSAL_FALLBACK=true
